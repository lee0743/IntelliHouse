{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninza:entry-envelope",
  "title": "진입 해석기 출력 봉투",
  "description": "structured output(constrained decoding)이 강제할 계약. operand 타입에서 포지션 어휘(entryPrice/barsSinceEntry)를 배제 → 어휘 격리(E-01 사전 차단)를 스키마로 강제.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "spec", "clarifications", "assumptions", "unsupported"],
  "properties": {
    "status": { "enum": ["ok", "needs_clarification", "unsupported", "not_a_strategy"] },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["long", "short"],
      "properties": {
        "long": { "type": "array", "items": { "$ref": "#/$defs/group" } },
        "short": { "type": "array", "items": { "$ref": "#/$defs/group" } }
      }
    },
    "clarifications": { "type": "array", "items": { "$ref": "#/$defs/clarification" } },
    "assumptions": { "type": "array", "items": { "$ref": "#/$defs/assumption" } },
    "unsupported": { "type": "array", "items": { "$ref": "#/$defs/unsupported" } }
  },
  "$defs": {
    "op": { "enum": ["CrossAbove", "CrossBelow", "GreaterThan", "LessThan", "GreaterThanOrEqual", "LessThanOrEqual", "Equals", "NotEquals"] },
    "operand": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": { "const": "indicator" },
            "name": { "type": "string" },
            "params": { "type": "object" },
            "input": { "enum": ["Close", "Open", "High", "Low", "Volume"] }
          },
          "required": ["type", "name", "params"]
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": { "const": "price" },
            "field": { "enum": ["Close", "Open", "High", "Low", "Volume"] }
          },
          "required": ["type", "field"]
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": { "const": "constant" },
            "value": { "type": "number" }
          },
          "required": ["type", "value"]
        }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lhs", "op", "rhs"],
      "properties": {
        "lhs": { "$ref": "#/$defs/operand" },
        "op": { "$ref": "#/$defs/op" },
        "rhs": { "$ref": "#/$defs/operand" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditions"],
      "properties": {
        "conditions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }
      }
    },
    "clarification": {
      "type": "object",
      "required": ["path", "question"],
      "properties": {
        "path": { "type": "string" },
        "question": { "type": "string" },
        "options": { "type": "array" },
        "allowFreeform": { "type": "boolean" }
      }
    },
    "assumption": {
      "type": "object",
      "required": ["path", "value", "reason"],
      "properties": { "path": { "type": "string" }, "value": {}, "reason": { "type": "string" } }
    },
    "unsupported": {
      "type": "object",
      "required": ["phrase", "reason"],
      "properties": {
        "phrase": { "type": "string" },
        "reason": { "type": "string" },
        "deferred_to": { "enum": ["exit", "risk"] },
        "carry": { "type": "string" }
      }
    }
  }
}
